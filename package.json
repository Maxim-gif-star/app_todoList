{
  "name": "noctis",
  "productName": "Noctis",
  "version": "0.1.0",
  "private": true,
  "author": "Noctis",
  "description": "Интерактивная доска дел с тремя парящими окнами",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run desktop",
    "desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "app.noctis.board",
    "productName": "Noctis",
    "files": [
      "dist",
      "electron"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Noctis.exe"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Noctis",
      "artifactName": "Noctis-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
